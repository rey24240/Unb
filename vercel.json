{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 308
    }
  ],
  "rewrites": [
    {
      "source": "/home",
      "destination": "/static/site.html"
    },
    {
      "source": "/apps",
      "destination": "/static/apps.html"
    },
    {
      "source": "/games",
      "destination": "/static/games.html"
    },
    {
      "source": "/browser",
      "destination": "/static/player.html"
    },
    {
      "source": "/player",
      "destination": "/static/player.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
